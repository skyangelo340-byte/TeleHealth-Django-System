"""Gemini API integration for AI-assisted symptom triage.

This module is a decision-support component for an academic/demo TeleHealth
system. It does not diagnose patients. Emergency handling remains deterministic
and is performed before Gemini is called.
"""

import json
import os
import time
from decimal import Decimal

from google import genai
from google.genai import types


MODEL_VERSION = os.environ.get("GEMINI_MODEL", "gemini-3.7-flash")

# Fallback models used only when the selected model is temporarily unavailable.
FALLBACK_MODELS = (
    MODEL_VERSION,
    "gemini-3.6-flash",
    "gemini-3.5-flash",
    "gemini-flash-lite-latest",
)

SPECIALTIES = (
    "General Medicine",
    "Dermatology",
    "Dental",
    "Ophthalmology",
    "Pediatrics",
    "Obstetrics",
)

RESULT_SCHEMA = {
    "type": "object",
    "properties": {
        "specialty": {
            "type": "string",
            "enum": list(SPECIALTIES),
            "description": "Best-fit medical specialty from the allowed list.",
        },
        "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": (
                "Model-reported confidence from 0 to 100. "
                "This is not clinically calibrated."
            ),
        },
        "extracted_symptoms": {
            "type": "array",
            "items": {"type": "string"},
            "description": (
                "Short symptom phrases explicitly supported "
                "by the patient's text."
            ),
        },
    },
    "required": [
        "specialty",
        "confidence",
        "extracted_symptoms",
    ],
}


class GeminiTriageError(RuntimeError):
    """Raised when Gemini triage cannot produce a valid result."""


def _client():
    api_key = os.environ.get("GEMINI_API_KEY", "").strip()

    if not api_key:
        raise GeminiTriageError(
            "GEMINI_API_KEY is not configured."
        )

    return genai.Client(api_key=api_key)


def _parse_result(response):
    parsed = getattr(response, "parsed", None)

    if parsed is not None:
        if hasattr(parsed, "model_dump"):
            return parsed.model_dump()

        if isinstance(parsed, dict):
            return parsed

    text = getattr(response, "text", "") or ""

    try:
        return json.loads(text)
    except (TypeError, json.JSONDecodeError) as exc:
        raise GeminiTriageError(
            "Gemini returned an invalid structured response."
        ) from exc


def _is_temporary_error(exc):
    """Return True for temporary Gemini availability/rate-limit errors."""

    status_code = getattr(exc, "status_code", None)

    if status_code in (429, 500, 502, 503, 504):
        return True

    message = str(exc).lower()

    temporary_messages = (
        "high demand",
        "temporarily unavailable",
        "unavailable",
        "rate limit",
        "too many requests",
        "resource exhausted",
        "overloaded",
    )

    return any(
        phrase in message
        for phrase in temporary_messages
    )


def _generate_with_fallback(client, prompt):
    """Try the configured model and safe fallback models."""

    last_error = None

    for model in FALLBACK_MODELS:
        for attempt in range(2):
            try:
                response = client.models.generate_content(
                    model=model,
                    contents=prompt,
                    config=types.GenerateContentConfig(
                        temperature=0,
                        response_mime_type="application/json",
                        response_schema=RESULT_SCHEMA,
                    ),
                )

                return response, model

            except Exception as exc:
                last_error = exc

                if not _is_temporary_error(exc):
                    raise

                if attempt == 0:
                    time.sleep(1)

        # Move to the next fallback model.

    raise GeminiTriageError(
        "Gemini is temporarily unavailable. "
        "Please try the assessment again later."
    ) from last_error


def gemini_triage_recommendation(data):
    """Classify a natural-language symptom description with Gemini.

    Only the symptom description and optional temperature are sent.
    Patient identity and other account information are intentionally
    not included.
    """

    symptoms = data.get("symptoms", "")

    if isinstance(symptoms, list):
        symptoms = " ".join(
            str(item).strip()
            for item in symptoms
            if str(item).strip()
        )

    symptoms = str(symptoms or "").strip()

    if not symptoms:
        raise GeminiTriageError(
            "Symptoms are required for Gemini triage."
        )

    temperature = data.get("temperature")

    temperature_text = (
        str(temperature).strip()
        if temperature not in (None, "")
        else "Not provided"
    )

    prompt = f"""
You are an AI-assisted triage classification component in a school/demo TeleHealth system.
You are NOT a doctor and must NOT diagnose the patient or prescribe treatment.

Task:
1. Extract only symptom phrases that are explicitly supported by the patient's wording.
2. Classify the concern into exactly one specialty from this list:
   General Medicine, Dermatology, Dental, Ophthalmology, Pediatrics, Obstetrics.
3. Give a model-reported confidence from 0 to 100. This confidence is not clinically calibrated.

Patient symptom description:
{symptoms}

Temperature, if provided:
{temperature_text}

Return only the requested structured result.
""".strip()

    client = _client()

    try:
        response, used_model = _generate_with_fallback(
            client,
            prompt,
        )

    except GeminiTriageError:
        raise

    except Exception as exc:
        raise GeminiTriageError(
            "Gemini triage request failed."
        ) from exc

    finally:
        client.close()

    result = _parse_result(response)

    specialty = str(
        result.get("specialty", "")
    ).strip()

    if specialty not in SPECIALTIES:
        raise GeminiTriageError(
            "Gemini returned an unsupported specialty."
        )

    try:
        confidence_value = float(
            result.get("confidence")
        )
    except (TypeError, ValueError) as exc:
        raise GeminiTriageError(
            "Gemini returned an invalid confidence value."
        ) from exc

    confidence_value = max(
        0.0,
        min(100.0, confidence_value),
    )

    extracted = result.get(
        "extracted_symptoms",
        [],
    )

    if not isinstance(extracted, list):
        raise GeminiTriageError(
            "Gemini returned invalid extracted symptoms."
        )

    extracted = [
        str(item).strip()
        for item in extracted
        if str(item).strip()
    ][:10]

    return {
        "specialty": specialty,
        "confidence": Decimal(
            f"{confidence_value:.2f}"
        ),
        "model": used_model,
        "extracted_symptoms": extracted,
    }